{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "push": true,
    "pushArgs": ["--follow-tags"]
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["npm run typecheck"],
    "after:bump": ["sed -i '' 's/APP_VERSION = \".*\"/APP_VERSION = \"${version}\"/' app/lib/version.ts && git add app/lib/version.ts"]
  }
}
